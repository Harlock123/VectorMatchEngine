<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VectorMatchEngine.UI.ViewModels"
        xmlns:v="using:VectorMatchEngine.UI.Views"
        x:Class="VectorMatchEngine.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Vector Match Engine"
        MinWidth="1100" MinHeight="700"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">
  <ContentControl Content="{Binding CurrentPage}">
    <ContentControl.DataTemplates>
      <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <v:HomeView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ImportViewModel}">
        <v:ImportView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DatasetsViewModel}">
        <v:DatasetsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:NewMatchJobViewModel}">
        <v:NewMatchJobView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:MatchJobsViewModel}">
        <v:MatchJobsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:MatchResultsViewModel}">
        <v:MatchResultsView/>
      </DataTemplate>
    </ContentControl.DataTemplates>
  </ContentControl>
</Window>
