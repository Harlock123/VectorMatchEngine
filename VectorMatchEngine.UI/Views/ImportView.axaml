<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VectorMatchEngine.UI.ViewModels"
             x:Class="VectorMatchEngine.UI.Views.ImportView"
             x:DataType="vm:ImportViewModel">
  <Grid Background="{StaticResource AppBackground}" Margin="16" RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,8,0,20">
      <TextBlock Classes="h1" Text="Import Dataset"/>
      <TextBlock Classes="subtle" Text="Step 1: choose a file  &#x2022;  Step 2: configure columns  &#x2022;  Step 3: process"/>
    </StackPanel>

    <!-- ── Step 1: select file ──────────────────────────────────────── -->
    <Border Grid.Row="1" Classes="card" VerticalAlignment="Top" MaxWidth="900"
            HorizontalAlignment="Left" IsVisible="{Binding IsStep1}">
      <StackPanel Spacing="16">
        <TextBlock Classes="h2" Text="Select an Excel workbook"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBox Text="{Binding SelectedFilePath}" IsReadOnly="True" MinWidth="620"
                   Watermark="No file selected"/>
          <Button Classes="secondary" Content="Browse..." Command="{Binding BrowseFileCommand}"/>
        </StackPanel>
        <TextBlock Classes="subtle" TextWrapping="Wrap"
                   Text="The first worksheet is used. Row 1 is treated as the header row. A vectors workbook (from &quot;Another spreadsheet&quot;) is recognised, and its vectors are loaded as they are."/>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Next  &#x2192;" Command="{Binding NextCommand}"/>
          <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center"
                       IsVisible="{Binding IsLoadingColumns}"/>
        </StackPanel>

        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"/>
      </StackPanel>
    </Border>

    <!-- ── Step 2: configure columns ────────────────────────────────── -->
    <!-- Settings on the left (scrolling if the window is short), the column list filling the right. -->
    <Grid Grid.Row="1" IsVisible="{Binding IsStep2}" RowDefinitions="*,Auto" ColumnDefinitions="460,*">
      <ScrollViewer Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
      <Border Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Dataset name"/>
          <TextBox Text="{Binding DatasetName, Mode=TwoWay}" Watermark="e.g. Customers 2026 Q1"/>
          <StackPanel Spacing="6" IsVisible="{Binding IsVectorWorkbook}">
            <TextBlock Classes="h2" Text="A vectors workbook" Margin="0,6,0,0"/>
            <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding VectorWorkbookSummary}"/>
            <TextBlock Classes="subtle" TextWrapping="Wrap"
                       Text="Its vectors are loaded into the database as they are, without vectorizing again, so it can be used in match jobs like any imported dataset."/>
          </StackPanel>
          <TextBlock Classes="subtle" TextWrapping="Wrap" IsVisible="{Binding IsColumnWorkbook}"
                     Text="Vectorize: the column's text is embedded into the similarity vector. Preserve: the value is stored verbatim so it can be shown and exported (ticking Vectorize unticks it; a column can still be both). Sounds alike: names are encoded by how they sound, so Smith and Smyth, or Jon and John, count as the same. Field type: cleans the values up before vectorizing, so the same thing written two ways matches (Bob and Robert, Acme Corp. and ACME Corporation, 3/4/1980 and 1980-03-04, (555) 010-1234 and 555.010.1234); give the other dataset's column the same type."/>

          <StackPanel Spacing="6" IsVisible="{Binding IsColumnWorkbook}">
            <TextBlock Classes="h2" Text="Matching key" Margin="0,6,0,0"/>
            <TextBox Text="{Binding MatchingKey, Mode=TwoWay}" PasswordChar="&#x2022;"
                     Watermark="A passphrase, shared only with whoever vectorizes the other dataset"/>
            <TextBlock Classes="subtle" TextWrapping="Wrap" Text="{Binding KeyStatus}"/>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsColumnWorkbook}">
          <TextBlock Classes="h2" Text="Write the vectors to" Margin="0,6,0,0"/>
          <StackPanel Spacing="4">
            <RadioButton Content="The database (for matching)"
                         IsChecked="{Binding WriteToDatabase, Mode=TwoWay}"/>
            <RadioButton Content="Another spreadsheet"
                         IsChecked="{Binding WriteToSpreadsheet, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding WriteToSpreadsheet}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding OutputFilePath}" IsReadOnly="True" Watermark="No output file chosen"/>
              <Button Grid.Column="1" Classes="secondary" Margin="8,0,0,0" Content="Choose File..."
                      Command="{Binding BrowseOutputFileCommand}"/>
            </Grid>
            <CheckBox IsChecked="{Binding IncludeVectorizedText, Mode=TwoWay}">
              <TextBlock TextWrapping="Wrap" Text="Also write the vectorized text (readable, so it shows what each vector was made from)"/>
            </CheckBox>
            <TextBlock Classes="subtle" TextWrapping="Wrap"
                       Text="A new workbook: a Vectors sheet with each row's preserved columns and one column per vector dimension (V0 to V511), plus an About sheet. Nothing is saved to the database; to match these rows later, import this workbook (it's recognised, and its vectors are loaded as they are)."/>
          </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      </ScrollViewer>

      <Border Grid.Row="0" Grid.Column="1" Classes="card" Padding="0" IsVisible="{Binding IsColumnWorkbook}">
        <DataGrid ItemsSource="{Binding ColumnSelections}"
                  AutoGenerateColumns="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
            <DataGridCheckBoxColumn Header="Vectorize" Binding="{Binding IsVectorized, Mode=TwoWay}" Width="120"/>
            <DataGridCheckBoxColumn Header="Preserve"  Binding="{Binding IsPreserved,  Mode=TwoWay}" Width="120"/>
            <DataGridCheckBoxColumn Header="Sounds alike" Binding="{Binding IsSoundsAlike, Mode=TwoWay}" Width="130"/>
            <DataGridTemplateColumn Header="Field type" Width="190">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ColumnSelectionItem">
                  <ComboBox ItemsSource="{x:Static vm:ColumnSelectionItem.KindLabels}"
                            SelectedIndex="{Binding KindIndex, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" Margin="4,2"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="8" Margin="0,14,0,0">
      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding PlaintextWarning}"
                 IsVisible="{Binding HasPlaintextWarning}"/>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="secondary" Content="&#x2190;  Back" Command="{Binding GoBackCommand}"/>
        <Button Classes="primary" Content="Process Dataset" Command="{Binding ProcessCommand}"/>
        <TextBlock Classes="subtle" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700"
                   Text="Select at least one column to vectorize, enter a name, and choose an output file if writing to a spreadsheet."
                   IsVisible="{Binding IsColumnWorkbook}"/>
      </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ── Step 3: processing / done ────────────────────────────────── -->
    <Border Grid.Row="1" Classes="card" VerticalAlignment="Top" MaxWidth="900"
            HorizontalAlignment="Left" IsVisible="{Binding IsStep3}">
      <StackPanel Spacing="16">
        <TextBlock Classes="h2" Text="Processing"/>

        <StackPanel Spacing="8" IsVisible="{Binding !IsDone}">
          <TextBlock Classes="body" Text="{Binding ProgressMessage}"/>
          <Grid ColumnDefinitions="*,Auto">
            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="10"
                         Value="{Binding ProgressValue}"/>
            <TextBlock Grid.Column="1" Classes="subtle" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{Binding ProgressValue, StringFormat='{}{0:0}%'}"/>
          </Grid>
        </StackPanel>

        <TextBlock Classes="success" FontSize="15" Text="{Binding SuccessSummary}"
                   IsVisible="{Binding IsDone}"/>

        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"/>

        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsProcessing}">
          <Button Classes="primary" Content="View Datasets" Command="{Binding GoToDatasetsCommand}"
                  IsVisible="{Binding SavedToDatabase}"/>
          <Button Classes="secondary" Content="Import Another" Command="{Binding ImportAnotherCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Button Grid.Row="2" Classes="secondary" Content="&#x2190;  Home"
            HorizontalAlignment="Left" Command="{Binding GoHomeCommand}"/>
  </Grid>
</UserControl>
